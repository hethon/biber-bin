{
  "$schema": "https://raw.githubusercontent.com/hethon/ingen/v0.4.0/schema/manifest.schema.json",
  "app_name": "biber",
  "app_version": "0.00",
  "owner": "hethon",
  "repo": "biber-bin",
  "tag": "v{app_version}",
  "base_urls": ["https://github.com/{owner}/{repo}/releases/download/{tag}"],
  "windows_archive": {
    "style": ".zip",
    "layout": "flat"
  },
  "unix_archive": {
    "style": ".tar.gz",
    "layout": "flat"
  },
  "executables": ["biber"],
  "cdylibs": [],
  "cstaticlibs": [],
  "min_glibc_version": "2.4",
  "bin_aliases": {},
  "install_paths": ["~/.local/bin"],
  "install_success_msg": "biber was successfully installed!",
  "archives": [
    {
      "id": "biber-i686-pc-windows-gnu.zip",
      "target": "i686-pc-windows-gnu"
    },
    {
      "id": "biber-i686-unknown-linux-gnu.tar.gz",
      "target": "i686-unknown-linux-gnu"
    },
    {
      "id": "biber-universal2-apple-darwin.tar.gz",
      "target": "aarch64-apple-darwin"
    },
    {
      "id": "biber-x86_64-apple-darwin.tar.gz",
      "target": "x86_64-apple-darwin"
    },
    {
      "id": "biber-x86_64-pc-windows-gnu.zip",
      "target": "x86_64-pc-windows-gnu"
    },
    {
      "id": "biber-x86_64-unknown-linux-gnu.tar.gz",
      "target": "x86_64-unknown-linux-gnu"
    },
    {
      "id": "biber-x86_64-unknown-linux-musl.tar.gz",
      "target": "x86_64-unknown-linux-musl"
    }
  ]
}
